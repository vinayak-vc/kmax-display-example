%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67d20fe47c4b8b140be827ec2b0b2e70, type: 3}
  m_Name: EyeAnatomyCatalog
  m_EditorClassIdentifier: KmaxDisplayExample::ViitorCloud.KmaxDisplayExample.EyeAnatomyCatalog
  parts:
  - displayName: Cornea
    description: The clear front window of the eye. It bends incoming light and does
      about two thirds of the eye's focusing before the lens.
    partPath: eye/cornea_outside
  - displayName: Tear film
    description: The thin moist layer washed over the cornea at every blink. It keeps
      the surface smooth enough to see through.
    partPath: eye/eye_over_cornea
  - displayName: Anterior chamber
    description: The fluid-filled space between the cornea and the iris. The aqueous
      humour in it feeds the cornea and sets the pressure inside the eye.
    partPath: eye/cornea_inside
  - displayName: Lens
    description: Sits behind the iris and fine-tunes focus. Ciliary muscles change
      its shape to shift between distant and close objects.
    partPath: eye/lens
  - displayName: Uvea
    description: The pigmented, vessel-rich layer lining the eye. At the front it
      forms the iris, whose pupil sets how much light gets in.
    partPath: eye/eye_sphere_inside
  - displayName: Sclera
    description: The tough white outer coat that holds the eye's shape and protects
      the inside. The eye muscles attach to it.
    partPath: eye/eye_sphere_outside
  - displayName: Retinal vessels
    description: The branching network spreading from the optic disc across the retina,
      supplying the light-sensitive tissue with oxygen.
    partPath: eye/half_veins
  - displayName: Optic nerve
    description: Carries every visual signal to the brain. Where it leaves the eye
      there are no photoreceptors, which is why we have a blind spot.
    partPath: eye/optical_nerv
  - displayName: Central retinal artery
    description: Travels inside the optic nerve and enters at the optic disc, then
      fans out as the retina's main blood supply.
    partPath: eye/optical_nerv/artery_retina_inside_1
  - displayName: Central retinal vein
    description: Drains blood away from the retina, leaving the eye alongside the
      central retinal artery inside the optic nerve.
    partPath: eye/optical_nerv/vein_retina_inside_1
  - displayName: Superior vortex veins
    description: Vortex veins carry blood out of the choroid. The upper pair pass
      through the sclera behind the eye's widest point.
    partPath: eye/vein_up
  - displayName: Inferior vortex veins
    description: The lower vortex veins, draining the underside of the choroid out
      through the sclera.
    partPath: eye/vein_down
  - displayName: Superior rectus
    description: Lies along the top of the eyeball and rolls the gaze upward. One
      of four rectus muscles anchored at the back of the orbit.
    partPath: eye/eye_muscles/muscle_3
  - displayName: Inferior rectus
    description: Runs under the eyeball and pulls the gaze downward, opposing the
      superior rectus.
    partPath: eye/eye_muscles/muscle_5
  - displayName: Medial rectus
    description: Turns the eye inward, toward the nose. Works against the lateral
      rectus to swing the gaze side to side.
    partPath: eye/eye_muscles/muscle_1
  - displayName: Lateral rectus
    description: Turns the eye outward, away from the nose, opposing the medial rectus.
    partPath: eye/eye_muscles/muscle_6
  - displayName: Superior oblique
    description: Threads through a small pulley near the nose before reaching the
      top of the eye, rotating it and pulling the gaze down and out.
    partPath: eye/eye_muscles/muscle_0
  - displayName: Inferior oblique
    description: Runs from the floor of the orbit to the outer eyeball, rotating
      it and lifting the gaze up and out.
    partPath: eye/eye_muscles/muscle_4
